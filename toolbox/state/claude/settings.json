{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "sonnet",
  "enableArtifact": false,
  "feedbackDrafts": "off",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 400000
    }
  },
  "env": {
    "TZ": "Asia/Kolkata",
    "CLAUDE_CODE_TIME_FORMAT": "12-hour"
  },
  "theme": "dark",
  "editorMode": "normal",
  "autoContinueAtUsageLimit": false
}
